file(READ "${CMAKE_CURRENT_SOURCE_DIR}/mod.json" MOD_IDENTITY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/mod.json")

function(read_identity key variable)
  string(JSON type ERROR_VARIABLE error TYPE "${MOD_IDENTITY}" "${key}")
  if(error OR NOT type STREQUAL "STRING")
    message(FATAL_ERROR "mod.json: missing string field ${key}")
  endif()
  string(JSON value GET "${MOD_IDENTITY}" "${key}")
  if(value STREQUAL "" OR value MATCHES "[\r\n\t]")
    message(FATAL_ERROR "mod.json: invalid ${key}")
  endif()
  set(${variable} "${value}" PARENT_SCOPE)
endfunction()

read_identity(version MOD_VERSION)
read_identity(displayName MOD_DISPLAY_NAME)
read_identity(shortName MOD_SHORT_NAME)
read_identity(binaryName MOD_BINARY_NAME)
read_identity(scriptPrefix MOD_SCRIPT_PREFIX)
read_identity(author MOD_AUTHOR)

if(NOT MOD_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
  message(FATAL_ERROR "mod.json: version must be major.minor.patch")
endif()
string(REPLACE "." ";" version_parts "${MOD_VERSION}")
foreach(part IN LISTS version_parts)
  if(part GREATER 65535)
    message(FATAL_ERROR "mod.json: version components must fit SKSE's 16-bit fields")
  endif()
endforeach()
foreach(variable MOD_SHORT_NAME MOD_BINARY_NAME MOD_SCRIPT_PREFIX)
  if(NOT "${${variable}}" MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "mod.json: ${variable} must be an identifier")
  endif()
endforeach()
foreach(variable MOD_DISPLAY_NAME MOD_AUTHOR)
  string(REPLACE "\\" "\\\\" ${variable}_CPP "${${variable}}")
  string(REPLACE "\"" "\\\"" ${variable}_CPP "${${variable}_CPP}")
endforeach()
