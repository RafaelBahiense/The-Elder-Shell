set(PREVIEW_THEME_FILE "${CMAKE_CURRENT_SOURCE_DIR}/skyrimDefault.json" CACHE FILEPATH "Framework theme JSON")
set(PREVIEW_FONT_FILE "" CACHE FILEPATH "Framework primary TTF/OTF, empty for ImGui default")
set(PREVIEW_FONT_SIZE "32" CACHE STRING "Framework medium font size")
if(NOT PREVIEW_FONT_SIZE MATCHES "^[0-9]+([.][0-9]+)?$" OR
   PREVIEW_FONT_SIZE LESS 8 OR PREVIEW_FONT_SIZE GREATER 96)
  message(FATAL_ERROR "Preview font size must be between 8 and 96 pixels")
endif()
file(READ "${PREVIEW_THEME_FILE}" theme)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PREVIEW_THEME_FILE}")
set(theme_values "")
foreach(member Alpha DisabledAlpha WindowRounding WindowBorderSize ChildRounding ChildBorderSize
    PopupRounding PopupBorderSize FrameRounding FrameBorderSize IndentSpacing ColumnsMinSpacing
    ScrollbarSize ScrollbarRounding GrabMinSize GrabRounding LogSliderDeadzone TabRounding
    TabBorderSize TabBarBorderSize SeparatorTextBorderSize MouseCursorScale)
  string(JSON value ERROR_VARIABLE missing GET "${theme}" "${member}")
  if(NOT missing)
    if(NOT value MATCHES "^-?[0-9]+([.][0-9]+)?$")
      message(FATAL_ERROR "Invalid theme value: ${member}")
    endif()
    string(APPEND theme_values "style.${member} = static_cast<float>(${value});\n")
  endif()
endforeach()
foreach(member WindowPadding WindowMinSize WindowTitleAlign FramePadding ItemSpacing ItemInnerSpacing
    CellPadding TouchExtraPadding ButtonTextAlign SelectableTextAlign SeparatorTextAlign SeparatorTextPadding
    DisplayWindowPadding DisplaySafeAreaPadding)
  string(JSON value ERROR_VARIABLE missing GET "${theme}" "${member}")
  if(NOT missing)
    string(JSON x GET "${value}" 0)
    string(JSON y GET "${value}" 1)
    if(NOT x MATCHES "^-?[0-9]+([.][0-9]+)?$" OR NOT y MATCHES "^-?[0-9]+([.][0-9]+)?$")
      message(FATAL_ERROR "Invalid theme vector: ${member}")
    endif()
    string(APPEND theme_values "style.${member} = {static_cast<float>(${x}), static_cast<float>(${y})};\n")
  endif()
endforeach()
string(JSON count LENGTH "${theme}" ImGuiCol)
if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON name MEMBER "${theme}" ImGuiCol ${index})
    string(JSON color GET "${theme}" ImGuiCol "${name}")
    if(NOT name MATCHES "^[A-Za-z0-9_]+$" OR NOT color MATCHES "^#[0-9a-fA-F]+$")
      message(FATAL_ERROR "Invalid theme color: ${name}")
    endif()
    string(LENGTH "${color}" length)
    if(NOT length EQUAL 9)
      message(FATAL_ERROR "Theme colors must use #RRGGBBAA: ${name}")
    endif()
    string(SUBSTRING "${color}" 1 8 rgba)
    string(APPEND theme_values "SetColor(style, \"${name}\", 0x${rgba}u);\n")
  endforeach()
endif()
set(has_font false)
if(PREVIEW_FONT_FILE)
  configure_file("${PREVIEW_FONT_FILE}" "${CMAKE_CURRENT_BINARY_DIR}/preview-font.ttf" COPYONLY)
  set(has_font true)
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/ThemeData.h" CONTENT
  "#pragma once\nnamespace preview {\ninline constexpr float FontSize = static_cast<float>(${PREVIEW_FONT_SIZE});\ninline constexpr bool HasFont = ${has_font};\ninline void ApplyThemeValues(ImGuiStyle& style) {\n${theme_values}}\n}\n")
